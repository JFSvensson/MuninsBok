{
  "name": "@muninsbok/api",
  "version": "0.3.1",
  "private": true,
  "description": "REST API for Munins bok",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
