    "@muninsbok/core": "workspace:*",
    "@muninsbok/db": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "prom-client": "^15.1.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
